# Пример конфига Telegram-моста. Скопируй в ~/.config/<agent>/telegram.env,
# заполни и поставь права 600. ЭТОТ ФАЙЛ С РЕАЛЬНЫМ ТОКЕНОМ В GIT НЕ КОММИТИТЬ.

# Токен бота от @BotFather (секрет)
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-real-token

# Разрешённые Telegram user id через запятую (узнать у @userinfobot)
TELEGRAM_ALLOWED_IDS=

# Метка агента
AGENT_NAME=jupiter

# Права инструментов в headless. Пусто = безопасно (только allowlist из settings.json).
# Для полной автономии (агент сам выполняет любые инструменты): --dangerously-skip-permissions
CLAUDE_PERMISSION_ARGS=

# Таймаут одного ответа агента, сек
CLAUDE_TIMEOUT=300
